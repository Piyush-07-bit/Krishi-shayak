# Copy this file to .env and fill values. Restart dev server after editing.

# Your LLM / n8n webhook URL. Must be accessible from the browser (or configure a dev proxy).
VITE_LLM_WEBHOOK_URL="http://localhost:5678/webhook/f00df675-741b-48e3-9367-6214cfdb6854/chat"

# Optional: a static secret for the webhook. If set, the client will send X-Webhook-Secret header.
VITE_LLM_WEBHOOK_SECRET="your-webhook-secret-if-any"

# Market API (optional). If you provide these the app will try to fetch live market prices.
# Example provider URL: https://api.example.com/market
VITE_MARKET_API_URL=""
# Example API key (for development only). Use hosting provider env vars for production.
VITE_MARKET_API_KEY=""

# Example: if you want to preconfigure Supabase keys for local dev (already often in your environment)
# VITE_SUPABASE_URL="https://xyz.supabase.co"
# VITE_SUPABASE_ANON_KEY="public-anon-key"
